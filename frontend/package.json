    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tsconfig/node22": "^22.0.6",
